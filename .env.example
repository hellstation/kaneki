BOT_TOKEN=your_telegram_bot_token_here

# Comma-separated Telegram user IDs; empty = anyone can use the bot
ALLOWED_USER_IDS=

# Optional: FSM persistence + shared rate limits (docker compose --profile redis)
REDIS_URL=

# Concurrent heavy OSINT jobs (Maigret, email scan, domain report)
OSINT_MAX_CONCURRENT=2

# Per-user cooldowns (seconds)
RATE_LIMIT_USERNAME_SECONDS=60
RATE_LIMIT_EMAIL_SECONDS=45
RATE_LIMIT_PHONE_SECONDS=20
RATE_LIMIT_VEHICLE_SECONDS=20
DOMAIN_RATE_LIMIT_SECONDS=10

# Maigret username scan
MAIGRET_TOP_SITES=500
MAIGRET_TIMEOUT=20
MAIGRET_MAX_CONNECTIONS=100
MAIGRET_PARSE_PROFILES=0

HOLEHE_TIMEOUT=90
HIBP_API_KEY=

# Domain Security Analyzer (optional — sections degrade without keys)
NVD_API_KEY=
SHODAN_API_KEY=
CENSYS_API_ID=
CENSYS_API_SECRET=
REQUEST_TIMEOUT=10
MAX_CVE_RESULTS=5
